# ==============================================================================
# Mobility Wallet Platform - Environment Variables Template
# Copy this file to '.env' (or set these in your hosting provider's dashboard)
# NOTE: Never commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
# Active Spring Profile: 'dev' (local development) or 'prod' (hardened production)
SPRING_PROFILES_ACTIVE=dev

# HTTP Port the application listens on (default: 8080)
PORT=8080

# ------------------------------------------------------------------------------
# Database Connection (MySQL 8.0+)
# ------------------------------------------------------------------------------
# Production JDBC URL (e.g. Railway, Render, Aiven, AWS RDS)
DB_URL=jdbc:mysql://localhost:3306/mobility_wallet?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# ------------------------------------------------------------------------------
# Production Admin Bootstrap (Required when SPRING_PROFILES_ACTIVE=prod)
# In production, default dev credentials (admin123/user123) are strictly rejected.
# ------------------------------------------------------------------------------
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeInProduction2026!
ADMIN_PHONE=9876543210

# ------------------------------------------------------------------------------
# Cloud Keep-Alive Heartbeat (Optional - for Render free tier sleep prevention)
# Set this as a repository secret (RENDER_APP_URL) in GitHub Actions.
# ------------------------------------------------------------------------------
RENDER_APP_URL=https://your-service-name.onrender.com
